/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2c_arm>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			pcf8574@20 {
				compatible = "nxp,pcf8574";
				reg = <0x20>;
				status = "okay";
			};

			pcf8574@21 {
				compatible = "nxp,pcf8574";
				reg = <0x21>;
				status = "okay";
			};
		};
	};
};
